# Build context for the Storybook preview image.
# The image only needs the source, the Storybook config and the lockfile.

# ---- Version control & tooling ------------------------------------------
.git
.github
.gitignore
.editorconfig
.vscode

# ---- Local state ---------------------------------------------------------
.DS_Store

# ---- Build artifacts (rebuilt inside the image) --------------------------
node_modules
storybook-static
dist

# ---- Not needed to build Storybook --------------------------------------
*.md
vitest.config.ts
