# Build context for the Storybook preview image.
# Keep this in sync with .gitignore; the image only needs the source, the
# Storybook config and the lockfile.

# ---- Version control & tooling ------------------------------------------
.git
.github
.gitignore
.editorconfig
.vscode

# ---- Local state ---------------------------------------------------------
.superlite
docs
.DS_Store

# ---- Build artifacts (rebuilt inside the image) --------------------------
node_modules
storybook-static
dist

# ---- Not needed to build Storybook --------------------------------------
*.md
playwright.config.ts
vitest.config.ts
