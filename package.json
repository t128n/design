{
  "name": "t128n-personal-design-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "t128n's personal design system: dense, flat, record-first UI tokens, generated CSS, and adoption tooling for t128n's own tools.",
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "lint": "bunx --bun designmd lint skills/t128n-ui/references/DESIGN.md",
    "build": "bun run lint && bun skills/t128n-ui/scripts/build.mjs",
    "check": "bun run build && git diff --exit-code -- skills/t128n-ui/assets",
    "test": "bun test",
    "preview:dev": "vite --config preview/vite.config.js",
    "preview:build": "vite build --config preview/vite.config.js",
    "preview:serve": "vite preview --config preview/vite.config.js"
  },
  "devDependencies": {
    "@google/design.md": "0.4.0",
    "@internationalized/date": "^3.12.4",
    "@primer/octicons": "^19.42.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "bits-ui": "2.20.2",
    "svelte": "5.57.2",
    "vite": "8.3.5"
  }
}
