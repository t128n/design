{
  "name": "t128n-design",
  "private": true,
  "license": "MIT",
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "bun@1.4.3",
  "scripts": {
    "changeset": "changeset",
    "version-packages": "changeset version && bun install --lockfile-only",
    "build": "bun run --filter '@t128n/ui' build",
    "verify": "bun run --filter '@t128n/ui' verify",
    "icons": "bun run packages/ui/scripts/build-app-icons.ts",
    "test": "vitest run --project=unit --passWithNoTests",
    "test:watch": "vitest --project=unit",
    "test:storybook": "vitest run --project=storybook",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@resvg/resvg-js": "^2.6.2",
    "@storybook/addon-a11y": "latest",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/addon-svelte-csf": "^5.1.6",
    "@storybook/addon-vitest": "10.6.5",
    "@storybook/svelte-vite": "latest",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@testing-library/jest-dom": "latest",
    "@testing-library/svelte": "latest",
    "@testing-library/user-event": "latest",
    "@types/node": "latest",
    "@vitest/browser-playwright": "^5",
    "@vitest/coverage-v8": "^5",
    "axe-core": "latest",
    "jsdom": "latest",
    "playwright": "latest",
    "storybook": "latest",
    "svelte": "latest",
    "typescript": "^5.9.3",
    "unplugin-icons": "^24.0.0",
    "vite": "^7.3.7",
    "vitest": "^5"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@iconify-json/carbon": "^1.2.29"
  }
}
