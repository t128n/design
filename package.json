{
  "name": "stellar-planet",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "build": "pnpm --filter @stellar/ui build",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:storybook": "storybook test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@storybook/addon-a11y": "latest",
    "@storybook/addon-svelte-csf": "^5.1.6",
    "@storybook/svelte-vite": "latest",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@testing-library/jest-dom": "latest",
    "@testing-library/svelte": "latest",
    "@testing-library/user-event": "latest",
    "@types/node": "latest",
    "@vitest/coverage-v8": "latest",
    "axe-core": "latest",
    "jsdom": "latest",
    "playwright": "latest",
    "storybook": "latest",
    "svelte": "latest",
    "typescript": "^5.9.3",
    "unplugin-icons": "^24.0.0",
    "vite": "^7.3.7",
    "vitest": "latest"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@iconify-json/carbon": "^1.2.29"
  }
}
