{
  "name": "@t128n/ui",
  "version": "0.2.1",
  "private": false,
  "license": "MPL-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/t128n/design.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/t128n/design/tree/main/packages/ui#readme",
  "bugs": {
    "url": "https://github.com/t128n/design/issues"
  },
  "engines": {
    "bun": ">=1.4.3",
    "node": ">=20"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles": "./dist/index.css",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md",
    "AGENTS.md",
    "docs/design-language.mdx",
    "docs/components.mdx"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "verify": "bun scripts/verify-package.ts && bun scripts/check-consumer.ts",
    "pack:check": "bun pm pack --dry-run",
    "prepublishOnly": "bun run build && bun run verify"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "bits-ui": "^2.20.2",
    "carbon-icons-svelte": "^13.17.0",
    "runed": "^0.35.1"
  },
  "devDependencies": {
    "@sveltejs/package": "^3.0.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "svelte": "latest",
    "svelte-check": "latest",
    "typescript": "^5.9.3"
  }
}
